# LightX2V Wan2.2 image for AMD RDNA4 gfx1201.
# Aiter is rebuilt from the local aiter_source build context, following vLLM's
# gfx1201 image structure. build_gfx1201.sh validates its pinned Git revision.
ARG BASE_IMAGE=rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0
ARG AITER_REPO=https://github.com/yangecool/aiter.git
ARG AITER_COMMIT=1b37c33172ea807d528de91c7b4f8f74ff61ec44
ARG AITER_ROCM_ARCH=gfx1201

########################################################################
# gfx1201_base - keep the Aiter runtime JIT toolchain in the final image.
########################################################################
FROM ${BASE_IMAGE} AS gfx1201_base

ARG ARG_PYTORCH_ROCM_ARCH=gfx1201
ENV VIRTUAL_ENV=/opt/venv \
    ROCM_PATH=/opt/rocm \
    PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH}

RUN if [ -f /etc/apt/sources.list ]; then \
        sed -i -E \
            's|https?://archive.ubuntu.com/ubuntu/?|https://mirrors.ctyun.cn/ubuntu/|g; s|https?://security.ubuntu.com/ubuntu/?|https://mirrors.ctyun.cn/ubuntu/|g' \
            /etc/apt/sources.list; \
    fi \
    && if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i -E \
            's|https?://archive.ubuntu.com/ubuntu/?|https://mirrors.ctyun.cn/ubuntu/|g; s|https?://security.ubuntu.com/ubuntu/?|https://mirrors.ctyun.cn/ubuntu/|g' \
            /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        pkg-config \
        python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -c 'import sys; assert sys.prefix == "/opt/venv" and sys.prefix != sys.base_prefix, f"PEP 668: expected /opt/venv Python, got {sys.executable} (prefix={sys.prefix}, base_prefix={sys.base_prefix})"' \
    && python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip config --site set \
        global.index-url https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple \
    && python3 -m pip install --no-cache-dir 'setuptools<80' wheel

########################################################################
# aiter_triton - provision the Triton version selected by pinned Aiter.
########################################################################
FROM gfx1201_base AS aiter_triton

RUN --mount=type=bind,from=aiter_source,source=.,target=/aiter-source \
    bash /aiter-source/.github/scripts/install_triton.sh \
    && python3 -c 'from importlib.metadata import distributions; wanted={"amd-triton", "pytorch-triton", "pytorch-triton-rocm", "torch", "torchaudio", "torchvision", "triton", "triton-kernels", "triton-rocm"}; rows=[f"{name}=={dist.version}" for dist in distributions() if (name := dist.metadata["Name"].lower().replace("_", "-")) in wanted]; print("\n".join(sorted(rows)))' \
        > /opt/rocm-stack.constraints.txt \
    && grep -q '^torch==' /opt/rocm-stack.constraints.txt \
    && grep -Eqi '^(amd-triton|pytorch-triton|pytorch-triton-rocm|triton|triton-rocm)==' \
        /opt/rocm-stack.constraints.txt

# setup.py must retain the Aiter-provisioned Triton in all child stages.
ENV AITER_USE_SYSTEM_TRITON=1

########################################################################
# build_aiter - build the pinned Aiter wheel without prebuilt kernels.
########################################################################
FROM aiter_triton AS build_aiter

ARG AITER_REPO
ARG AITER_COMMIT
ARG AITER_ROCM_ARCH
ARG MAX_JOBS
ENV MAX_JOBS=${MAX_JOBS}

WORKDIR /app
COPY --from=aiter_source . /app/aiter
RUN cd /app/aiter \
    && python3 -m pip install --no-cache-dir \
        --constraint /opt/rocm-stack.constraints.txt \
        -r requirements.txt \
    && PREBUILD_KERNELS=0 GPU_ARCHS="${AITER_ROCM_ARCH}" \
       python3 setup.py bdist_wheel --dist-dir=dist \
    && mkdir -p /app/aiter-install \
    && cp dist/*.whl /app/aiter-install/

########################################################################
# final - install Aiter, LightX2V source, then runtime dependencies.
########################################################################
FROM aiter_triton AS final

ARG BASE_IMAGE
ARG BASE_IMAGE_DIGEST=unknown
ARG BASE_IMAGE_ID=unknown
ARG AITER_REPO
ARG AITER_COMMIT
ARG AITER_ROCM_ARCH
ARG ARG_PYTORCH_ROCM_ARCH=gfx1201
ARG LIGHTX2V_REVISION=unknown
ARG BASE_IMAGE_SOURCE=unknown

LABEL org.opencontainers.image.title="LightX2V gfx1201"
LABEL org.opencontainers.image.description="LightX2V Wan2.2 on ROCm/Aiter for AMD gfx1201"
LABEL org.opencontainers.image.source="https://github.com/yangecool/LightX2V"
LABEL org.opencontainers.image.revision="${LIGHTX2V_REVISION}"
LABEL org.opencontainers.image.base.name="${BASE_IMAGE_SOURCE}"
LABEL org.opencontainers.image.base.digest="${BASE_IMAGE_DIGEST}"
LABEL org.opencontainers.image.aiter.revision="${AITER_COMMIT}"

ENV PLATFORM=amd_rocm \
    DTYPE=BF16 \
    TOKENIZERS_PARALLELISM=false \
    ROCM_PATH=/opt/rocm \
    PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH} \
    AITER_ROCM_ARCH=${AITER_ROCM_ARCH} \
    AITER_REPO=${AITER_REPO} \
    AITER_COMMIT=${AITER_COMMIT} \
    AITER_JIT_DIR=/workspace/.cache/aiter \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    SAFETENSORS_FAST_GPU=1

# Replace any Aiter package inherited from the base image.
RUN --mount=type=bind,from=build_aiter,src=/app/aiter-install,target=/aiter-install \
    python3 -m pip uninstall -y amd-aiter aiter 2>/dev/null || true \
    && python3 -m pip install --no-cache-dir \
        --constraint /opt/rocm-stack.constraints.txt \
        /aiter-install/*.whl

# Install LightX2V from source before resolving its runtime dependencies.
WORKDIR /workspace/LightX2V
COPY . /workspace/LightX2V
RUN python3 -m pip install --no-cache-dir --no-build-isolation -e . --no-deps

# Install Python runtime dependencies last. Constraints make an indirect
# dependency conflict fail instead of replacing the ROCm torch/Triton stack.
RUN sed -E '/^[[:space:]]*(torch|torchvision|torchaudio|sgl-kernel)([[:space:]]*[<=>~!].*)?([[:space:]]*#.*)?$/d' \
        requirements.txt > /tmp/requirements.gfx1201.txt \
    && python3 -m pip install --no-cache-dir \
        --constraint /opt/rocm-stack.constraints.txt \
        -r /tmp/requirements.gfx1201.txt \
    && python3 -m pip install --no-cache-dir \
        --constraint /opt/rocm-stack.constraints.txt \
        'av' 'torchada>=0.1.10' \
    && mkdir -p "${AITER_JIT_DIR}" \
    && chmod 0777 "${AITER_JIT_DIR}" \
    && rm -f /tmp/requirements.gfx1201.txt

RUN mkdir -p /app \
    && { \
        echo "BASE_IMAGE=${BASE_IMAGE_SOURCE}"; \
        echo "BASE_IMAGE_REFERENCE=${BASE_IMAGE}"; \
        echo "BASE_IMAGE_DIGEST=${BASE_IMAGE_DIGEST}"; \
        echo "BASE_IMAGE_ID=${BASE_IMAGE_ID}"; \
        echo "LIGHTX2V_REVISION=${LIGHTX2V_REVISION}"; \
        echo "AITER_REPO=${AITER_REPO}"; \
        echo "AITER_COMMIT=${AITER_COMMIT}"; \
        echo "AITER_ROCM_ARCH=${AITER_ROCM_ARCH}"; \
        echo "PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH}"; \
    } >> /app/versions.txt \
    && python3 -c 'import triton; print("TRITON_VERSION=" + triton.__version__)' >> /app/versions.txt

ENTRYPOINT []
CMD ["bash"]
