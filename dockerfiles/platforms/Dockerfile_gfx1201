# LightX2V Wan2.2 image for AMD RDNA4 gfx1201.
# The vLLM base owns ROCm, PyTorch, torchvision, torchaudio, Triton, and
# FlashAttention. Aiter and LightX2V are rebuilt from local source contexts.
ARG BASE_IMAGE=vllm/vllm-openai-rocm:v0.25.0-base
ARG APT_MIRROR=https://mirrors.ctyun.cn/ubuntu
ARG PIP_INDEX_URL=https://mirrors.ctyun.cn/pypi/simple
ARG UV_VERSION=0.11.32
ARG AITER_REPO=https://github.com/yangecool/aiter.git
ARG AITER_COMMIT=unknown
ARG AITER_VERSION=0.1.16.post3+gfx1201
ARG AITER_ROCM_ARCH=gfx1201

########################################################################
# gfx1201_base - retain the exact framework stack from the vLLM base.
########################################################################
FROM ${BASE_IMAGE} AS gfx1201_base

ARG APT_MIRROR
ARG PIP_INDEX_URL
ARG UV_VERSION
ARG ARG_PYTORCH_ROCM_ARCH=gfx1201

ENV DEBIAN_FRONTEND=noninteractive \
    ROCM_PATH=/opt/rocm \
    PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH} \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    UV_INDEX_URL=${PIP_INDEX_URL} \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    AITER_USE_SYSTEM_TRITON=1

RUN apt_mirror="${APT_MIRROR%/}" \
    && for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do \
        if [ -f "${source_file}" ]; then \
            sed -i -E \
                "s|https?://(archive|security).ubuntu.com/ubuntu/?|${apt_mirror}/|g" \
                "${source_file}"; \
        fi; \
    done \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        pkg-config \
        python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip config --global set global.index-url "${PIP_INDEX_URL}" \
    && python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir \
        "setuptools>=77.0.3,<80" wheel "uv==${UV_VERSION}"

# Freeze every binary package inherited from the base that is coupled to the
# custom ROCm PyTorch/Triton build. Downstream dependency installs may use the
# stack, but may not replace it with public PyPI wheels.
RUN python3 -c 'from importlib.metadata import distributions; wanted={"amd-triton", "flash-attn", "flash-attn-3", "pytorch-triton", "pytorch-triton-rocm", "torch", "torchaudio", "torchvision", "triton", "triton-kernels", "triton-rocm"}; rows=[f"{name}=={dist.version}" for dist in distributions() if (name := dist.metadata["Name"].lower().replace("_", "-")) in wanted]; print("\n".join(sorted(set(rows))))' \
        > /opt/rocm-stack.constraints.txt \
    && grep -q '^torch==' /opt/rocm-stack.constraints.txt \
    && grep -Eqi '^(amd-triton|pytorch-triton|pytorch-triton-rocm|triton|triton-rocm)==' \
        /opt/rocm-stack.constraints.txt

########################################################################
# build_aiter - compile the current local Aiter source for gfx1201.
########################################################################
FROM gfx1201_base AS build_aiter

ARG AITER_COMMIT
ARG AITER_VERSION
ARG AITER_ROCM_ARCH
ARG MAX_JOBS
ENV MAX_JOBS=${MAX_JOBS}

WORKDIR /app
COPY --from=aiter_source . /app/aiter

RUN cd /app/aiter \
    && rm -rf build dist \
    && uv pip install --system \
        --constraint /opt/rocm-stack.constraints.txt \
        -r requirements.txt \
    && SETUPTOOLS_SCM_PRETEND_VERSION="${AITER_VERSION}" \
       PREBUILD_KERNELS=0 GPU_ARCHS="${AITER_ROCM_ARCH}" \
       python3 setup.py bdist_wheel --dist-dir=dist \
    && test "$(find dist -maxdepth 1 -name '*.whl' | wc -l)" -eq 1 \
    && mkdir -p /app/aiter-install \
    && cp dist/*.whl /app/aiter-install/

########################################################################
# final - install local Aiter, pinned Wan2.2 dependencies, and LightX2V.
########################################################################
FROM gfx1201_base AS final

ARG BASE_IMAGE
ARG BASE_IMAGE_DIGEST=unknown
ARG BASE_IMAGE_ID=unknown
ARG BASE_IMAGE_SOURCE=unknown
ARG LIGHTX2V_REVISION=unknown
ARG AITER_REPO
ARG AITER_COMMIT
ARG AITER_VERSION
ARG AITER_ROCM_ARCH
ARG ARG_PYTORCH_ROCM_ARCH=gfx1201

LABEL org.opencontainers.image.title="LightX2V gfx1201"
LABEL org.opencontainers.image.description="LightX2V Wan2.2 on the vLLM ROCm base with local Aiter"
LABEL org.opencontainers.image.source="https://github.com/yangecool/LightX2V"
LABEL org.opencontainers.image.revision="${LIGHTX2V_REVISION}"
LABEL org.opencontainers.image.base.name="${BASE_IMAGE_SOURCE}"
LABEL org.opencontainers.image.base.digest="${BASE_IMAGE_DIGEST}"
LABEL org.opencontainers.image.aiter.revision="${AITER_COMMIT}"
LABEL org.opencontainers.image.aiter.version="${AITER_VERSION}"

ENV PLATFORM=amd_rocm \
    DTYPE=BF16 \
    TOKENIZERS_PARALLELISM=false \
    ROCM_PATH=/opt/rocm \
    PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH} \
    AITER_ROCM_ARCH=${AITER_ROCM_ARCH} \
    AITER_REPO=${AITER_REPO} \
    AITER_COMMIT=${AITER_COMMIT} \
    AITER_VERSION=${AITER_VERSION} \
    AITER_JIT_DIR=/workspace/.cache/aiter \
    HSA_ENABLE_IPC_MODE_LEGACY=1 \
    HIP_FORCE_DEV_KERNARG=1 \
    PYTORCH_NVML_BASED_CUDA_CHECK=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    SAFETENSORS_FAST_GPU=1

RUN --mount=type=bind,from=build_aiter,src=/app/aiter-install,target=/aiter-install \
    python3 -m pip uninstall -y amd-aiter aiter 2>/dev/null || true \
    && uv pip install --system \
        --constraint /opt/rocm-stack.constraints.txt \
        /aiter-install/*.whl

WORKDIR /workspace/LightX2V
COPY . /workspace/LightX2V

# This list contains only the runtime used by the Wan2.2 image. Deployment,
# database, queue, cloud SDK, Gradio, and training dependencies stay out of the
# image and therefore cannot force unrelated pydantic or aio package solves.
RUN --mount=type=cache,id=lightx2v-gfx1201-uv,target=/root/.cache/uv \
    uv pip install --system \
        --constraint /opt/rocm-stack.constraints.txt \
        -r dockerfiles/platforms/requirements_gfx1201.txt

# These packages declare a generic PyTorch dependency. Their runtime
# dependencies are already pinned above, so do not let them re-resolve the
# custom ROCm framework stack.
RUN --mount=type=cache,id=lightx2v-gfx1201-uv,target=/root/.cache/uv \
    uv pip install --system --no-deps \
        accelerate==1.13.0 \
        peft==0.19.1 \
        qtorch==0.3.0

RUN uv pip install --system --no-deps --no-build-isolation -e . \
    && mkdir -p "${AITER_JIT_DIR}" \
    && chmod 0777 "${AITER_JIT_DIR}"

RUN mkdir -p /app \
    && { \
        echo "LIGHTX2V_IMAGE_BASE=${BASE_IMAGE_SOURCE}"; \
        echo "LIGHTX2V_IMAGE_BASE_REFERENCE=${BASE_IMAGE}"; \
        echo "LIGHTX2V_IMAGE_BASE_DIGEST=${BASE_IMAGE_DIGEST}"; \
        echo "LIGHTX2V_IMAGE_BASE_ID=${BASE_IMAGE_ID}"; \
        echo "LIGHTX2V_REVISION=${LIGHTX2V_REVISION}"; \
        echo "AITER_REPO=${AITER_REPO}"; \
        echo "AITER_COMMIT=${AITER_COMMIT}"; \
        echo "AITER_VERSION=${AITER_VERSION}"; \
        echo "AITER_ROCM_ARCH=${AITER_ROCM_ARCH}"; \
        echo "PYTORCH_ROCM_ARCH=${ARG_PYTORCH_ROCM_ARCH}"; \
        cat /opt/rocm-stack.constraints.txt; \
    } >> /app/versions.txt \
    && python3 -c 'from importlib.metadata import version; print("AITER_INSTALLED_VERSION=" + version("amd-aiter")); print("ACCELERATE_VERSION=" + version("accelerate")); print("PEFT_VERSION=" + version("peft")); print("TRANSFORMERS_VERSION=" + version("transformers"))' \
        >> /app/versions.txt

ENTRYPOINT []
CMD ["bash"]
